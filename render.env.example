# Set these in Render -> Environment. Never commit real values.
# Current production choice: keep the existing ChatGPT/D1 portal.
WORDCLICK_CHATGPT_PORTAL_URL=https://wordclick-private.danielbrat14.chatgpt.site
# The values below are needed only for the optional Google/Supabase adapter.
APP_BASE_URL=https://worldclick.onrender.com
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
SECRET_KEY=GENERATE_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
# Google Client ID/Secret are stored in Supabase Auth -> Providers -> Google,
# not in this file and not in browser JavaScript.
